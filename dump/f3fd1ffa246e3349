    const minD = data[0].date.getTime(), maxD = data[data.length-1].date.getTime();
    const maxV = Math.max(...data.map(d => d.value));

    console.log('Date range:', new Date(minD), 'to', new Date(maxD)); // Debug line
    console.log('Max value:', maxV); // Debug line

    let ns = 0, ne = 1, drag = false, dm = null, dsx = 0, dsns = 0, dsne = 0;

    // ---- Responsive layout (base design = 460px wide) ----
    let scale = 1;
    let M, W, H, N, NW, NH, mcCssW, mcCssH, ncCssW, ncCssH;

    function setupCanvas(canvas, cssW, cssH) {
        const dpr = window.devicePixelRatio || 1;
        canvas.width  = Math.round(cssW * dpr);
        canvas.height = Math.round(cssH * dpr);
        canvas.style.width  = cssW + 'px';
        canvas.style.height = cssH + 'px';
        const ctx = canvas.getContext('2d');
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function computeLayout() {
        const containerW = wrapper.clientWidth || 460;
        scale = containerW / 460;

        M  = { t: 20*scale, r: 30*scale, b: 50*scale, l: 60*scale };
        W  = 370*scale; H = 250*scale;
        N  = { t: 20*scale, r: 30*scale, b: 35*scale, l: 60*scale };
        NW = 370*scale; NH = 30*scale;

        mcCssW = containerW; mcCssH = 320*scale;
        ncCssW = containerW; ncCssH = 100*scale;

        setupCanvas(mc, mcCssW, mcCssH);
        setupCanvas(nc, ncCssW, ncCssH);
    }

    function fmt(n) { return n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","); }
    function fdate(d) { const m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']; return m[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear(); }

    function gd(r) { return new Date(minD + (maxD - minD) * r); }
    function gv() { const s = gd(ns), e = gd(ne); return data.filter(d => d.date >= s && d.date <= e); }

    function xm(d) {
        const s = gd(ns).getTime(), e = gd(ne).getTime();
        return M.l + ((d.getTime() - s) / (e - s)) * W;
    }

    function xn(d) {
        return N.l + ((d.getTime() - minD) / (maxD - minD)) * NW;
    }

    function yn(v) { return N.t + NH - (v / maxV) * NH; }

    function getNiceYAxis(maxVal) {
        const maxB = maxVal / 1000; // Convert to billions
        let inc;

        if (maxB <= 0.025) {
            inc = 0.005;
        } else if (maxB <= 0.05) {
            inc = 0.01;
        } else if (maxB <= 0.1) {
            inc = 0.025;
        } else if (maxB <= 0.25) {
            inc = 0.05;
        } else if (maxB <= 0.5) {
            inc = 0.1;
        } else if (maxB <= 1) {
            inc = 0.25;
        } else if (maxB <= 2.5) {
            inc = 0.5;
        } else if (maxB <= 5) {
            inc = 1;
        } else if (maxB <= 10) {
            inc = 2;
        } else if (maxB <= 25) {
            if (maxB <= 15) inc = 2.5;
            else inc = 5;
        } else if (maxB <= 50) {
            if (maxB <= 37.5) inc = 5;
            else inc = 10;
        } else if (maxB <= 100) {
            if (maxB <= 75) inc = 10;
            else inc = 25;
        } else if (maxB <= 250) {
            if (maxB <= 150) inc = 25;
            else inc = 50;
        } else if (maxB <= 500) {
            if (maxB <= 375) inc = 50;
            else inc = 100;
        } else if (maxB <= 1000) {
            if (maxB <= 750) inc = 100;
            else inc = 250;
        } else if (maxB <= 2500) {
            if (maxB <= 1500) inc = 250;
            else inc = 500;
        } else {
            inc = 500;
        }

        const niceMax = Math.ceil(maxB / inc) * inc;
        return { increment: inc, max: niceMax * 1000 };
    }

    function dm1() {
        mctx.clearRect(0, 0, mcCssW, mcCssH);

        const v = gv(); if (!v.length) return;
        const vm = Math.max(...v.map(d => d.value), 1), yAxis = getNiceYAxis(vm), yMax = yAxis.max, yInc = yAxis.increment * 1000, numTicks = Math.floor(yMax / yInc);
        const s = gd(ns), e = gd(ne);

        // Draw horizontal grid lines
        mctx.strokeStyle = '#c0c0c0';
        mctx.lineWidth = 1;
        for (let i = 0; i <= numTicks; i++) {
            const y = M.t + H - (i * yInc / yMax) * H;
            mctx.beginPath();
            mctx.moveTo(M.l, y);
            mctx.lineTo(M.l + W, y);
            mctx.stroke();
        }

        // Draw y-axis labels
        mctx.fillStyle = '#42515A';
        mctx.font = Math.max(9, 12*scale) + 'px Arial';
        mctx.textAlign = 'right';
        mctx.textBaseline = 'middle';
        for (let i = 0; i <= numTicks; i++) {
            const valB = (i * yInc) / 1, y = M.t + H - (i * yInc / yMax) * H;
            mctx.fillText(Math.round(valB), M.l - 5, y);
        }

        // Draw the line chart
            mctx.save();
            mctx.beginPath();
            mctx.rect(M.l, M.t, W, H);
            mctx.clip();

            mctx.strokeStyle = '#61AEE1';
            mctx.lineWidth = 2;
            mctx.beginPath();
            v.forEach((d, i) => {
                const x = xm(d.date), y = M.t + H - (d.value / yMax) * H;
                i === 0 ? mctx.moveTo(x, y) : mctx.lineTo(x, y);
            });
            mctx.stroke();

            mctx.restore();


        // Draw x-axis labels (years)
        mctx.fillStyle = '#666666';
        mctx.font = Math.max(9, 12*scale) + 'px Arial';
        mctx.textAlign = 'center';
        mctx.textBaseline = 'top';
        const minYear = s.getFullYear(), maxYear = e.getFullYear();
        const yearSpan = maxYear - minYear;
        let yearInterval;
        if (yearSpan <= 5) yearInterval = 1;
        else if (yearSpan <= 20) yearInterval = 2;
        else if (yearSpan <= 50) yearInterval = 5;
        else yearInterval = 10;

     
            for (let year = Math.ceil(minYear / yearInterval) * yearInterval; year <= maxYear; year += yearInterval) { 
                const d = new Date(year, 0, 1);
                if (d >= s && d <= e) {
                    const x = xm(d);
                    if (x >= M.l && x <= M.l + W) {
                        mctx.fillText(year, x, M.t + H + 5);
                    }
                }
            }
        }

        function dn1() {
            nctx.clearRect(0, 0, ncCssW, ncCssH);

            // Draw background
            nctx.fillStyle = '#F5F5F5';
            nctx.fillRect(N.l, N.t, NW, NH);

            // Draw the line chart in the navigator
            nctx.save();
            nctx.beginPath();
            nctx.rect(N.l, N.t, NW, NH);
            nctx.clip();

            nctx.strokeStyle = '#61AEE1';
            nctx.lineWidth = 1;
            nctx.beginPath();
            data.forEach((d, i) => {
                const x = xn(d.date), y = yn(d.value);
                i === 0 ? nctx.moveTo(x, y) : nctx.lineTo(x, y);
            });
            nctx.stroke();

            nctx.restore();

            const x1 = N.l + ns * NW, x2 = N.l + ne * NW;


            // Draw mask areas outside the selection (lighter overlay)
            nctx.fillStyle = 'rgba(245,245,245,0.7)';
            nctx.fillRect(N.l, N.t, x1 - N.l, NH);
            nctx.fillRect(x2, N.t, N.l + NW - x2, NH);

            // Draw the selection box border
            nctx.strokeStyle = '#CCCCCC';
            nctx.lineWidth = 1;
            nctx.strokeRect(x1, N.t, x2 - x1, NH);

            // Draw the handle bars on left and right
            const handleWidth = Math.max(6, 8 * scale);
            const handleHeight = NH;
            const handleColor = '#999999';
            const handleBorderColor = '#CCCCCC';

            // Left handle
            nctx.fillStyle = handleColor;
            nctx.fillRect(x1 - handleWidth/2, N.t, handleWidth, handleHeight);
            nctx.strokeStyle = handleBorderColor;
            nctx.lineWidth = 1;
            nctx.strokeRect(x1 - handleWidth/2, N.t, handleWidth, handleHeight);

            // Left handle grip lines
            nctx.strokeStyle = '#FFFFFF';
            nctx.lineWidth = 1;
            nctx.beginPath();
            nctx.moveTo(x1 - 2, N.t + 8);
            nctx.lineTo(x1 - 2, N.t + NH - 8);
            nctx.stroke();
            nctx.beginPath();
            nctx.moveTo(x1 + 2, N.t + 8);
            nctx.lineTo(x1 + 2, N.t + NH - 8);
            nctx.stroke();

            // Right handle
            nctx.fillStyle = handleColor;
            nctx.fillRect(x2 - handleWidth/2, N.t, handleWidth, handleHeight);
            nctx.strokeStyle = handleBorderColor;
            nctx.lineWidth = 1;
            nctx.strokeRect(x2 - handleWidth/2, N.t, handleWidth, handleHeight);

            // Right handle grip lines
            nctx.strokeStyle = '#FFFFFF';
            nctx.lineWidth = 1;
            nctx.beginPath();
            nctx.moveTo(x2 - 2, N.t + 8);
            nctx.lineTo(x2 - 2, N.t + NH - 8);
            nctx.stroke();
            nctx.beginPath();
            nctx.moveTo(x2 + 2, N.t + 8);
            nctx.lineTo(x2 + 2, N.t + NH - 8);
            nctx.stroke();

            // Draw year labels below navigator
            nctx.fillStyle = '#666666';
            nctx.font = Math.max(9, 12*scale) + 'px Arial';
            nctx.textAlign = 'center';
            nctx.textBaseline = 'top';
            const minY = data[0].date.getFullYear(), maxY = data[data.length - 1].date.getFullYear();
            const ySpan = maxY - minY;
            let labInt;
            if (ySpan <= 20) labInt = 5;
            else if (ySpan <= 50) labInt = 10;
            else labInt = 20;

            for (let year = Math.ceil(minY / labInt) * labInt; year <= maxY; year += labInt) {
                const d = new Date(year, 0, 1), x = xn(d);
                if (x >= N.l && x <= N.l + NW) nctx.fillText(year, x, N.t + NH + 5);
            }
        }

        function dr() { dm1(); dn1(); }

        nc.addEventListener('mousedown', e => {
            const r = nc.getBoundingClientRect(), x = e.clientX - r.left,
                  x1 = N.l + ns * NW, x2 = N.l + ne * NW;
            if (Math.abs(x - x1) < 12) dm = 'left';
            else if (Math.abs(x - x2) < 12) dm = 'right';
            else if (x > x1 && x < x2) dm = 'middle';
            else return;
            drag = true; dsx = x; dsns = ns; dsne = ne;
        });
        document.addEventListener('mousemove', e => {
            if (!drag) return;
            const r = nc.getBoundingClientRect(), x = e.clientX - r.left, dx = (x - dsx) / NW;
            if (dm === 'left') ns = Math.max(0, Math.min(dsns + dx, ne - 0.05));
            else if (dm === 'right') ne = Math.min(1, Math.max(dsne + dx, ns + 0.05));
            else if (dm === 'middle') { const w = dsne - dsns; ns = Math.max(0, Math.min(dsns + dx, 1 - w)); ne = ns + w; }
            dr();
        });
        document.addEventListener('mouseup', () => { drag = false; });

        

nc.addEventListener('touchstart', e => {
    const r = nc.getBoundingClientRect(),
          t = e.touches[0],
          x = t.clientX - r.left,
          x1 = N.l + ns * NW,
          x2 = N.l + ne * NW;
    if (Math.abs(x - x1) < 12) dm = 'left';
    else if (Math.abs(x - x2) < 12) dm = 'right';
    else if (x > x1 && x < x2) dm = 'middle';
    else return;
    drag = true; dsx = x; dsns = ns; dsne = ne;
    e.preventDefault();
}, { passive: false });

document.addEventListener('touchmove', e => {
    if (!drag) return;
    const r = nc.getBoundingClientRect(),
          t = e.touches[0],
          x = t.clientX - r.left,
          dx = (x - dsx) / NW;
    if (dm === 'left') ns = Math.max(0, Math.min(dsns + dx, ne - 0.05));
    else if (dm === 'right') ne = Math.min(1, Math.max(dsne + dx, ns + 0.05));
    else if (dm === 'middle') {
        const w = dsne - dsns;
        ns = Math.max(0, Math.min(dsns + dx, 1 - w));
        ne = ns + w;
    }
    dr();
    e.preventDefault();
}, { passive: false });

document.addEventListener('touchend', () => { drag = false; });






        mc.addEventListener('mousemove', e => {
            const r = mc.getBoundingClientRect(), mx = e.clientX - r.left, my = e.clientY - r.top, v = gv();
            if (!v.length) return;
            const vm = Math.max(...v.map(d => d.value), 1), yAxis = getNiceYAxis(vm), yMax = yAxis.max;
            let n = null, md = Infinity;
            v.forEach(d => {
                const x = xm(d.date), y = M.t + H - (d.value / yMax) * H,
                      di = Math.sqrt(Math.pow(mx - x, 2) + Math.pow(my - y, 2));
                if (di < md) { if (di < 20) { md = di; n = d; } }
            });
            if (n) {
                tt.style.display = 'block';
                tt.style.left = (e.clientX - r.left + 10) + 'px';
                tt.style.top = (e.clientY - r.top - 40) + 'px';

                tt.innerHTML = '<b>' + fdate(n.date) + '</b><br>Reverse Repo: $' + fmt(n.value.toFixed(2)) + ' billion';

                dr();
                const x = xm(n.date), y = M.t + H - (n.value / yMax) * H;
                mctx.fillStyle = '#FFF'; mctx.strokeStyle = '#61AEE1'; mctx.lineWidth = 2;
                mctx.beginPath(); mctx.arc(x, y, 4, 0, 2 * Math.PI); mctx.fill(); mctx.stroke();
            } else {
                tt.style.display = 'none';
                dr();
            }
        });
        mc.addEventListener('mouseleave', () => { tt.style.display = 'none'; dr(); });

        computeLayout();
        dr();
        console.log('Chart rendered #2'); // Debug line

        let resizeTO;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTO);
            resizeTO = setTimeout(() => {
                computeLayout();
                dr();
            }, 100);
        });
}
