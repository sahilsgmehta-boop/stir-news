		<title>Struggling Regional Small Businesses Deeply Pessimistic About 2026 Prospects</title>
		<link>https://libertystreeteconomics.newyorkfed.org/2026/06/struggling-regional-small-businesses-deeply-pessimistic-about-2026-prospects/</link>
		
		<dc:creator><![CDATA[]]></dc:creator>
		<pubDate>Tue, 02 Jun 2026 11:00:00 +0000</pubDate>
				<category><![CDATA[Credit]]></category>
