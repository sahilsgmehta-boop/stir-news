		<title>U.S. Banks Have Developed a Significant Nonbank Footprint</title>
		<link>https://libertystreeteconomics.newyorkfed.org/2025/11/u-s-banks-have-developed-a-significant-nonbank-footprint/</link>
		
		<dc:creator><![CDATA[]]></dc:creator>
		<pubDate>Tue, 18 Nov 2025 12:00:00 +0000</pubDate>
				<category><![CDATA[Banks]]></category>
		<category><![CDATA[Financial Intermediation]]></category>
