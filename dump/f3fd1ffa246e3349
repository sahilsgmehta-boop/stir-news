e":true,"tick":{"centered":false,"culling":false,"fit":true,"outer":true,"multiline":false,"multilineMax":0,"format":"%Y","values":["01\/01\/2004","01\/01\/2008","01\/01\/2012","01\/01\/2016","01\/01\/2020","01\/01\/2024"]},"label":{"text":"","position":"outer-center"},"format":"%Y-%m-%d"},"y":{"show":true,"inner":false,"type":"linear","inverted":false,"tick":{"centered":false,"culling":false,"values":["0","2","4","6","8","10","12","14"]},"padding":{"top":3,"bottom":0},"primary":"","secondary":"","label":{"text":"","position":"outer-middle"},"max":14,"min":0},"y2":{"show":false,"inner":false,"type":"linear","inverted":false,"padding":{"top":3,"bottom":0},"label":{"text":"","position":"outer-middle"}}},"chartLabel":"Percent of balance","color":{"pattern":["#61AEE1","#B84645","#B1812C","#046C9D","#9FA1A8","#DCB56E"]},"interaction":{"enabled":true},"point":{"show":false},"legend":{"show":true,"position":"bottom"},"grid":{"x":{"show":false,"lines":[],"type":"indexed","stroke":""},"y":{"show":true,"lines":[],"type":"linear","stroke":""}},"regions":[],"zoom":false,"subchart":false,"download":true,"downloadText":"Download chart","downloadName":"chart","trend":{"show":false,"label":"Trend"}}</script>
