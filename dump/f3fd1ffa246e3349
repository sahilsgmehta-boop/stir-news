	<div class="wdg-c3-chart__labels">
		<p class="wdg-c3-chart__label wdg-c3-chart__label--1">Percent of balance</p>
	</div>
	<script type="application/json">{"padding":{"auto":false,"left":21,"right":0},"data":{"groups":[],"labels":false,"type":"line","order":"desc","selection":{"enabled":false,"grouped":true,"multiple":true,"draggable":true},"x":"date","xFormat":"%m\/%d\/%Y","rows":[["date","90+ days past due (CCP)","Transition into 90+ days past due (CCP)","30+ days past due (Call Reports)"],["3\/31\/2003","8.84","8.27","4.57"],["6\/30\/2003","8.9","8.41","4.38"],["9\/30\/2003","8.67","8.17","4.29"],["12\/31\/2003","9.24","8.06","4.62"],["3\/31\/2004","9.27","7.77","4.1"],["6\/30\/2004","8.85","7.34","4.02"],["9\/30\/2004","8.65","7.14","4.12"],["12\/31\/2004","9.18","7","4.2"],["3\/31\/2005","9.59","6.64","3.62"],["6\/30\/2005","9.23","6.36","3.56"],["9\/30\/2005","9.07","6.27","3.95"],["12\/31\/2005","8.53","5.79","3.65"],["3\/31\/2006","8.82","5.51","3.8"],["6\/30\/2006","8.96","5.61","4.01"],["9\/30\/2006","9.19","5.59","4.17"],["12\/31\/2006","9.66","5.83","4.05"],["3\/31\/2007","9.74","6.18","3.96"],["6\/30\/2007","9.38","6.36","3.9"],["9\/30\/2007","9.34","6.52","4.45"],["12\/31\/2007","9.48","6.75","4.68"],["3\/31\/2008","9.49","7.27","4.8"],["6\/30\/2008","10.15","7.66","4.74"],["9\/30\/2008","9.48","8.13","4.83"],["12\/31\/2008","10.18","8.7","5.72"],["3\/31\/2009","11.44","9.56","6.61"],["6\/30\/2009","11.74","10.2","6.53"],["9\/30\/2009","11.9","10.51","6.51"],["12\/31\/2009","12.7","10.96","6.43"],["3\/31\/2010","13.73","10.8","5.88"],["6\/30\/2010","13.74","10.63","4.9"],["9\/30\/2010","13.16","10.23","4.59"],["12\/31\/2010","13.27","9.21","4.22"],["3\/31\/2011","13.12","7.99","3.89"],["6\/30\/2011","12.16","6.9","3.5"],["9\/30\/2011","11.5","6.26","3.47"],["12\/31\/2011","11.48","5.87","3.32"],["3\/31\/2012","11.27","5.41","3.1"],["6\/30\/2012","10.9","5.19","2.79"],["9\/30\/2012","10.45","4.85","2.84"],["12\/31\/2012","10.57","4.51","2.78"],["3\/31\/2013","10.21","4.41","2.67"],["6\/30\/2013","9.99","4.28","2.41"],["9\/30\/2013","9.36","4.03","2.47"],["12\/31\/2013","9.