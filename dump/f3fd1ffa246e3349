		<title>Measuring Labor Market Tightness: Data Update and New Web Feature</title>
		<link>https://libertystreeteconomics.newyorkfed.org/2026/01/measuring-labor-market-tightness-data-update-and-new-web-feature/</link>
		
		<dc:creator><![CDATA[]]></dc:creator>
