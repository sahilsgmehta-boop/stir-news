#B1812C","#046C9D","#9FA1A8","#DCB56E"]},"interaction":{"enabled":true},"point":{"show":false},"legend":{"show":true,"position":"bottom"},"grid":{"x":{"show":false,"lines":[],"type":"indexed","stroke":""},"y":{"show":true,"lines":[],"type":"linear","stroke":""}},"zoom":false,"subchart":false,"download":true,"downloadText":"Download chart","downloadName":"chart","trend":{"show":false,"label":"Trend"}}</script>
