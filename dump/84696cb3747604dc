		<title>Key Takeaways from President Williams’s Speech on the Longer&#8209;Run Framework</title>
		<link>https://tellerwindow.newyorkfed.org/2020/10/07/key-takeaways-from-president-williamss-speech-on-the-longer-run-framework/</link>
		
		<dc:creator><![CDATA[Felicity Barber, Executive Speech Writer, Communications and Outreach]]></dc:creator>
		<pubDate>Wed, 07 Oct 2020 18:20:00 +0000</pubDate>
